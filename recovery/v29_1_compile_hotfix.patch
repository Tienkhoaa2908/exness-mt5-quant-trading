+int MonthKey(const datetime t)
+{
+   MqlDateTime x; if(!TimeToStruct(t,x)) return 0;
+   return x.year*100+x.mon;
+}
 
+string MonthTagFromKey(const int key)
+{
+   int y=key/100, m=key%100;
+   return IntegerToString(y)+"_"+(m<10?"0":"")+IntegerToString(m);
+}
+
+bool NewBar()
+{
+   datetime t[1]; if(CopyTime(_Symbol,_Period,0,1,t)!=1) return false;
+   if(t[0]==g_last_bar) return false; g_last_bar=t[0]; return true;
+}
+
+bool ReadOne(const int h,const int buffer,const int shift,double &out)
+{
+   double v[1]; if(h==INVALID_HANDLE || CopyBuffer(h,buffer,shift,1,v)!=1) return false;
+   out=v[0]; return MathIsValidNumber(out);
+}
+
+int SecondsOfDay(const datetime t)
+{
+   MqlDateTime x; if(!TimeToStruct(t,x)) return -1;
+   return x.hour*3600+x.min*60+x.sec;
+}
 
